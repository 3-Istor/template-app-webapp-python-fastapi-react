{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make install)",
      "Bash(make migrate)",
      "Bash(make migration *)"
    ],
    "ask": [
      "Edit(/deploy/env/**)",
      "Edit(/deploy/security.yaml)",
      "Edit(/.github/workflows/security.yml)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)"
    ]
  },
  "extraKnownMarketplaces": {
    "cnp-agent-kit": {
      "source": {
        "source": "github",
        "repo": "3-Istor/cnp-agent-kit"
      }
    }
  },
  "enabledPlugins": {
    "cnp@cnp-agent-kit": true
  }
}
